# Read by the Next.js server. Required for dashboard and operator routes.
OPERATOR_KEY=

# Read by the server. Empty uses data/sim-desk.sqlite.
DATABASE_PATH=

# Read by the server after a queue. Set to 1 to wake the phone over adb.
SIMDESK_WAKE=

# Read by the server when SIMDESK_WAKE=1. Empty uses the only connected adb device.
ADB_SERIAL=

# Read by the dashboard pairing card. Phone base URL when adb reverse is down.
LAN_BASE_URL=
PUBLIC_URL=
